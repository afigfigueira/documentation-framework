+      "document_id": "DF-DID-005",
+      "path": "02-Documentation/DocumentIdentity/02-Structure/DF-DID-005 - Document Identity Schema.md",
+      "sha256": "06848d5545855826bf92bb215bb074276841b3da074cf0588115121e9c21ae18",
