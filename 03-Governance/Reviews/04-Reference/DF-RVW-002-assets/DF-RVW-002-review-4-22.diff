+        "| **Author** | Arnaldo Figueira |"
+      ]
+    },
+    {
+      "id": "DID009-02",
+      "severity": "High",
+      "sections": "1–2;4.2;5.1–5.3;11;14",
+      "observation": "Every document/major component andeach classification/template is treated as already using a document identity without assigned-normalized scope orseparation oflogical documents,files,exact editions andother definition/instance/entity endpoints.",
+      "proposal": "Scope document-identity consumption to actual applicable assigned normalized document subjects;apply functional exclusions anddistinguish classification/Template/Metadata entities,exact editions andactual consumer needs without universal mandatory routing/dependencies.",
+      "closure_criterion": "DID-001/003/005/006/008 andARC-005 actual role/population comparisons;no automatic DF IDs forevery file/entity oruniversal source-of-truth service.",
+      "state": "Open",
+      "literal_source_evidence": [
+        "every document within the Documentation Framework to be uniquely recognised.",
+        "Although every major component interacts with document identities",
+        "Each classification shall reference an existing document identity.",
+        "Template documents possess document identities in exactly the same manner as every other document."
+      ]
+    },
