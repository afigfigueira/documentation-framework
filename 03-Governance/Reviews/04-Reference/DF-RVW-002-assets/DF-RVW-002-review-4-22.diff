+  "records": [
+    {
+      "id": "DID009-01",
+      "severity": "Medium",
+      "sections": "Header;1;13–14",
+      "observation": "Received Family Documentation differs from canonical component Family;Canonical/Baseline1.0 andabsent edition history do not establish an approved working successor.",
+      "proposal": "Use Family/Component Document Identity,retain Type Structure andID/path;preserve original Arnaldo contribution/received declarations andadd evidenced later contributor only on actual UPDATE.",
+      "closure_criterion": "Exact header/history/compatibility andPolicy3/5/7;working Draft/unassigned,cumulative provenance explicit.",
+      "state": "Open",
+      "literal_source_evidence": [
+        "| **Family** | Documentation |",
